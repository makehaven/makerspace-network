rules_version = '2';

// The people layer (docs/GOVERNANCE.md, docs/PEOPLE.md). These rules are the
// authority: everything the browser does is checked here, and there is no
// Cloud Function in the write path. Nexus learned the hard way that custom
// claims written by Functions and never read by rules are decoration; here
// the only source of role is the documents themselves.
//
// Collections
//   people/{uid}              who a signed-in person is; email is their own
//   memberships/{uid}_{space} a person's standing at one space
//   stewardships/{uid}        region stewards and network admins
//   spaces_index/{space}      mirror of data/spaces the rules can read, plus proposals
//   roster/{uid}              what verified people may see about each other
//   messages/{id}             relayed messages between verified people
//   meetings/{id}             convened meetings; rsvps/{uid} beneath each
//   invitations/{space~email} a named person invited to one organisation, prefilled
//   groups/{slug}             mailing lists: members/, threads/, threads/*/posts/
//   reply_keys/{key}          Function-only map from a reply address to group, thread, person
//   listing_submissions/{space} a space's own answers for its public listing, for the steward to merge
//   space_metrics/{space~year}  annual network data — private to the space and its stewards
//   assessments/{space}         a space's Standards self-assessment — its own staff only, never stewards
//   assessment_summaries/{space} the level and domain averages a space chose to share with the network
//   feedback/{id}             anyone's feedback on the site; stewards read
//   audit/{id}                append-only

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function tokenEmail() { return request.auth.token.email.lower(); }
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function emailDomain() { return tokenEmail().split('@')[1]; }

    // The first network admin has to come from somewhere. These addresses may
    // grant themselves network_admin once; everything after that is granted.
    function isBootstrapAdmin() {
      return emailVerified() && tokenEmail() in ['jrlogan@makehaven.org'];
    }

    // ---------- lookups ----------
    function path(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    function stewardDoc() { return get(path('stewardships', uid())); }
    function hasStewardship() { return signedIn() && exists(path('stewardships', uid())); }
    function isNetworkAdmin() { return hasStewardship() && stewardDoc().data.network_admin == true; }
    function isSteward() { return hasStewardship() && stewardDoc().data.region_ids.size() > 0; }
    function isStewardOf(regionId) {
      return hasStewardship() && regionId != null && regionId in stewardDoc().data.region_ids;
    }

    function membershipPath(u, spaceId) { return path('memberships', u + '_' + spaceId); }
    function hasMembership(u, spaceId) { return exists(membershipPath(u, spaceId)); }
    function membership(u, spaceId) { return get(membershipPath(u, spaceId)).data; }
    function activeRoleAt(spaceId) {
      return hasMembership(uid(), spaceId) && membership(uid(), spaceId).status == 'active'
        ? membership(uid(), spaceId).role : null;
    }
    function isSpaceAdmin(spaceId) { return activeRoleAt(spaceId) == 'space_admin'; }
    function isOrganiserAt(spaceId) { return activeRoleAt(spaceId) in ['space_admin', 'space_editor']; }

    function personDoc() { return get(path('people', uid())).data; }
    function hasPerson() { return signedIn() && exists(path('people', uid())); }

    // "Verified": an active membership at the person's primary space.
    function isVerified() {
      return hasPerson()
        && personDoc().primary_space_id != null
        && hasMembership(uid(), personDoc().primary_space_id)
        && membership(uid(), personDoc().primary_space_id).status == 'active';
    }

    function spaceExists(spaceId) { return exists(path('spaces_index', spaceId)); }
    function space(spaceId) { return get(path('spaces_index', spaceId)).data; }
    // spaces_index holds makerspaces and ecosystem partners (agencies, funders,
    // support organisations...). An entry without `kind` is a makerspace.
    function isPartnerOrg(spaceId) { return space(spaceId).get('kind', 'makerspace') == 'partner'; }
    // Only a makerspace can be joined or claimed on the strength of an email
    // domain. A partner is always confirmed by a steward: a matching ct.gov
    // address says you work for the state, not which office speaks for it.
    function domainMatches(spaceId) {
      return emailVerified()
        && !isPartnerOrg(spaceId)
        && space(spaceId).domain != null
        && space(spaceId).domain == emailDomain();
    }

    function isIso(v) { return v is string && v.size() >= 20 && v.size() <= 40; }

    // An invitation is addressed to one email at one organisation; its id is
    // `{space_id}~{email}`, so the rules can find it with get() and a second
    // invitation to the same address overwrites the first.
    function invitationPath(spaceId, email) { return path('invitations', spaceId + '~' + email); }
    function myInvitation(spaceId) { return get(invitationPath(spaceId, tokenEmail())).data; }
    // Accepting: a live invitation for this role, addressed to the signed-in
    // verified email, flipped to accepted in the same batch.
    function invitedAs(spaceId, role) {
      return emailVerified()
        && exists(invitationPath(spaceId, tokenEmail()))
        && myInvitation(spaceId).status == 'pending'
        && myInvitation(spaceId).role == role
        && request.time < myInvitation(spaceId).expires_at
        && getAfter(invitationPath(spaceId, tokenEmail())).data.status == 'accepted';
    }

    // ---------- people ----------
    match /people/{personId} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['name', 'email', 'email_domain', 'phone', 'primary_space_id', 'created_at', 'updated_at'])
          && d().name is string && d().name.size() > 0 && d().name.size() <= 120
          && d().email == tokenEmail()
          && d().email_domain == emailDomain()
          && (d().phone == null || (d().phone is string && d().phone.size() <= 40))
          && (d().primary_space_id == null
              || existsAfter(membershipPath(personId, d().primary_space_id)))
          && isIso(d().updated_at);
      }
      // Not readable by verified peers: this document holds the email and
      // phone that the roster withholds from anyone relayed. A space admin
      // may read the people whose primary space is theirs, which includes
      // someone waiting for them to confirm (joinSpace sets it on request).
      allow get: if signedIn() && (uid() == personId || isSteward() || isNetworkAdmin()
                                   || isSpaceAdmin(resource.data.primary_space_id));
      allow list: if isSteward() || isNetworkAdmin();
      allow create: if signedIn() && uid() == personId && shape() && isIso(d().created_at);
      allow update: if signedIn() && (
          (uid() == personId && shape()
            && d().diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'primary_space_id', 'updated_at']))
          // A confirmer may set someone's primary space, once, so the roster
          // entry can be written for them. Nothing else about them.
          || ((isSteward() || isNetworkAdmin() || isSpaceAdmin(d().primary_space_id))
            && d().diff(resource.data).affectedKeys().hasOnly(['primary_space_id', 'updated_at'])
            && resource.data.primary_space_id == null
            && existsAfter(membershipPath(personId, d().primary_space_id))
            && isIso(d().updated_at))
          // A merge moves the primary space off a duplicate that is going away.
          || (isNetworkAdmin()
            && d().diff(resource.data).affectedKeys().hasOnly(['primary_space_id', 'updated_at'])
            && existsAfter(membershipPath(personId, d().primary_space_id))
            && !existsAfter(membershipPath(personId, resource.data.primary_space_id))
            && isIso(d().updated_at))
        );
      allow delete: if isNetworkAdmin();
    }

    // ---------- memberships ----------
    match /memberships/{mid} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['person_id', 'space_id', 'role', 'status', 'functions', 'contact_preference',
                                   'invitations', 'state', 'region_id', 'confirmed_by', 'created_at', 'updated_at'])
          && d().person_id is string && d().space_id is string
          && d().role in ['space_admin', 'space_editor', 'space_contact', 'partner']
          // Partner orgs have partners and nothing else; makerspaces never do.
          && (d().role == 'partner') == (spaceAfter(d().space_id).get('kind', 'makerspace') == 'partner')
          && d().status in ['pending', 'active', 'suspended', 'revoked']
          && d().functions is list && d().functions.size() <= 10
          && d().contact_preference in ['email', 'phone', 'relay']
          && d().invitations is bool
          && isIso(d().updated_at);
      }
      // The space as it stands after this batch. Proposing a space that is not
      // listed creates its index entry and the proposer's membership in one
      // batch, so a plain get() would not find it yet.
      function spaceAfter(spaceId) { return getAfter(path('spaces_index', spaceId)).data; }
      // The copied space fields must agree with the index, or a person could
      // file themselves under a region whose steward never sees them.
      function agreesWithSpace() {
        return d().state == spaceAfter(d().space_id).state && d().region_id == spaceAfter(d().space_id).region_id;
      }
      function claimsInSameBatch() {
        return space(d().space_id).claimed == false
          && getAfter(path('spaces_index', d().space_id)).data.claimed == true;
      }

      allow read: if signedIn() && (
          resource.data.person_id == uid()
          || isOrganiserAt(resource.data.space_id)
          || isStewardOf(resource.data.region_id)
          || isNetworkAdmin());

      // Self-join. What you get depends on whether your verified email is at
      // the space's own domain (GOVERNANCE §Claiming).
      allow create: if signedIn() && shape()
        && mid == uid() + '_' + d().space_id
        && d().person_id == uid()
        && existsAfter(path('spaces_index', d().space_id))
        && agreesWithSpace()
        && d().confirmed_by == null
        && isIso(d().created_at)
        && (
          // Everyone else is a contact, or a partner, waiting for confirmation.
          // First, so a space proposed in this same batch never reaches the
          // lookups below, which read the index as it was before the batch.
          (d().role in ['space_contact', 'partner'] && d().status == 'pending')
          // Domain-matched at a real space: admin if unclaimed (and claim it
          // in the same batch), editor/contact right away, or choose to wait.
          || (domainMatches(d().space_id) && space(d().space_id).proposed == false && (
              (d().role == 'space_admin' && d().status == 'active' && claimsInSameBatch())
              || (d().role in ['space_editor', 'space_contact'] && d().status == 'active')
              || d().status == 'pending'))
          // Invited: active at once, in exactly the role the inviter chose.
          || (d().status == 'active' && space(d().space_id).proposed == false && invitedAs(d().space_id, d().role))
        );

      // Merging a duplicate organisation into the real one: the network admin
      // re-files each person's membership under the real organisation, with
      // the same role and status, and deletes the duplicate's in the batch.
      allow create: if isNetworkAdmin() && shape()
        && mid == d().person_id + '_' + d().space_id
        && existsAfter(path('spaces_index', d().space_id))
        && spaceAfter(d().space_id).get('proposed', false) == false
        && agreesWithSpace()
        && isIso(d().created_at);

      allow update: if signedIn() && shape()
        && d().person_id == resource.data.person_id
        && d().space_id == resource.data.space_id
        && d().created_at == resource.data.created_at
        && (
          // Yourself: profile fields only, never your own standing.
          (resource.data.person_id == uid()
            && d().diff(resource.data).affectedKeys().hasOnly(['functions', 'contact_preference', 'invitations', 'updated_at']))
          // A space admin: anyone's standing at that space, and nothing above admin exists.
          || (isSpaceAdmin(resource.data.space_id)
            && d().diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'confirmed_by', 'updated_at']))
          || isStewardOf(resource.data.region_id)
          || isNetworkAdmin()
        );
      allow delete: if isNetworkAdmin();
    }

    // ---------- stewardships ----------
    match /stewardships/{personId} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['region_ids', 'network_admin', 'granted_by', 'created_at'])
          && d().region_ids is list && d().network_admin is bool && d().granted_by is string;
      }
      allow read: if signedIn() && (uid() == personId || isSteward() || isNetworkAdmin());
      allow create, update: if shape() && (
          isNetworkAdmin()
          || (isBootstrapAdmin() && uid() == personId && d().network_admin == true && !exists(path('stewardships', personId))));
      allow delete: if isNetworkAdmin() && uid() != personId;
    }

    // ---------- spaces_index ----------
    match /spaces_index/{spaceId} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['name', 'kind', 'partner_type', 'domain', 'state', 'region_id', 'size_tier',
                                   'proposed', 'proposed_by', 'website', 'city', 'claimed', 'updated_at'])
          && d().kind in ['makerspace', 'partner']
          && (d().kind == 'partner') == (d().partner_type != null)
          && (d().partner_type == null
              || d().partner_type in ['government', 'funder', 'support_org', 'education', 'industry', 'network', 'other'])
          && d().name is string && d().name.size() > 0 && d().name.size() <= 160
          && (d().domain == null || d().domain is string)
          && (d().state == null || (d().state is string && d().state.size() == 2))
          && (d().size_tier == null || d().size_tier in ['small', 'medium', 'large'])
          && d().proposed is bool && d().claimed is bool
          && isIso(d().updated_at);
      }
      allow read: if signedIn();
      allow create: if shape() && (
          (isNetworkAdmin() && d().proposed == false)
          // A steward adds the partner organisations of their own region.
          || (isStewardOf(d().region_id) && d().kind == 'partner' && d().proposed == false
              && d().claimed == false && spaceId.matches('^partner-[a-z0-9-]{3,60}$'))
          // Anyone may propose a space that is not listed. It stays marked
          // proposed, nobody can be more than a pending contact at it, and
          // the network admin turns it into a directory record or deletes it.
          || (signedIn() && d().proposed == true && d().proposed_by == uid() && d().claimed == false
              && d().region_id == null && d().state != null
              && spaceId.matches('^proposed-[a-z0-9-]{3,60}$')));
      allow update: if shape() && (
          isNetworkAdmin()
          || ((isStewardOf(resource.data.region_id) || isSpaceAdmin(spaceId))
              && d().diff(resource.data).affectedKeys().hasOnly(['size_tier', 'updated_at']))
          || (isStewardOf(resource.data.region_id) && resource.data.kind == 'partner'
              && d().diff(resource.data).affectedKeys().hasOnly(['name', 'partner_type', 'domain', 'website', 'city', 'updated_at']))
          // The claim: only ever false → true, only by a domain match, only
          // together with the admin membership that justifies it.
          || (domainMatches(spaceId)
              && resource.data.proposed == false && resource.data.claimed == false && d().claimed == true
              && d().diff(resource.data).affectedKeys().hasOnly(['claimed', 'updated_at'])
              && getAfter(membershipPath(uid(), spaceId)).data.role == 'space_admin'
              && getAfter(membershipPath(uid(), spaceId)).data.status == 'active')
          // ...or by accepting an invitation to be its admin.
          || (resource.data.proposed == false && resource.data.claimed == false && d().claimed == true
              && d().diff(resource.data).affectedKeys().hasOnly(['claimed', 'updated_at'])
              && invitedAs(spaceId, 'space_admin')
              && getAfter(membershipPath(uid(), spaceId)).data.status == 'active'));
      allow delete: if isNetworkAdmin();
    }

    // ---------- a space's own data ----------
    // Who may see a space's data before it is public: the space's own
    // organisers, the steward of its region, the network admin. The region is
    // read from the index, never from the document, so it cannot be misfiled.
    function caresFor(spaceId) {
      return isOrganiserAt(spaceId)
        || (spaceExists(spaceId) && isStewardOf(space(spaceId).region_id))
        || isNetworkAdmin();
    }

    // The listing questionnaire. Public once merged into data/spaces by a
    // steward, with the space itself recorded as the source. Until then it is
    // a submission, not a fact.
    match /listing_submissions/{spaceId} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['listing', 'status', 'submitted_by', 'submitted_name', 'updated_at'])
          && d().listing is map && d().listing.size() <= 30
          && d().status in ['submitted', 'merged']
          && d().submitted_name is string && d().submitted_name.size() <= 120
          && isIso(d().updated_at);
      }
      allow get: if signedIn() && caresFor(spaceId);
      allow list: if isSteward() || isNetworkAdmin();
      allow create, update: if shape() && (
          (isOrganiserAt(spaceId) && d().status == 'submitted' && d().submitted_by == uid())
          || ((isNetworkAdmin() || (spaceExists(spaceId) && isStewardOf(space(spaceId).region_id)))
              && (resource == null || d().diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))));
      allow delete: if isNetworkAdmin();
    }

    // Annual network data (the Standards tool's Annual Data tab). Organisational
    // figures, never published attributed to a space: the network reports
    // aggregates only. Id is `{space_id}~{year}`.
    match /space_metrics/{mid} {
      function sid() { return mid.split('~')[0]; }
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['space_id', 'year', 'metrics', 'capabilities', 'untracked', 'estimated', 'updated_by', 'updated_at'])
          && d().space_id == sid()
          && mid == sid() + '~' + string(d().year)
          && d().year is int && d().year >= 2015 && d().year <= 2100
          && d().metrics is map && d().metrics.size() <= 60
          && d().capabilities is list && d().capabilities.size() <= 20
          // "We don't track this" and "this is an estimate" are answers too.
          && d().get('untracked', []) is list && d().get('untracked', []).size() <= 60
          && d().get('estimated', []) is list && d().get('estimated', []).size() <= 60
          && d().updated_by == uid()
          && isIso(d().updated_at);
      }
      allow get: if signedIn() && caresFor(sid());
      allow list: if isSteward() || isNetworkAdmin();
      allow create, update: if shape() && isOrganiserAt(sid()) && spaceExists(sid()) && !isPartnerOrg(sid());
      allow delete: if isNetworkAdmin();
    }

    // ---------- Standards of Excellence ----------
    // The full assessment is the space's own business: every score, every
    // piece of evidence, every note. Not even the steward reads it, because a
    // benchmark that leaks per-standard scores teaches everyone to inflate.
    match /assessments/{spaceId} {
      function d() { return request.resource.data; }
      allow get: if signedIn() && isOrganiserAt(spaceId);
      allow create, update: if isOrganiserAt(spaceId) && spaceExists(spaceId) && !isPartnerOrg(spaceId)
        && d().keys().hasOnly(['framework_version', 'flags', 'goal', 'answers', 'updated_by', 'updated_at'])
        && d().framework_version is int
        && d().flags is map && d().flags.size() <= 20
        && d().goal in ['foundational', 'operational', 'accredited']
        && d().answers is map && d().answers.size() <= 200
        && d().updated_by == uid()
        && isIso(d().updated_at);
      allow delete: if isNetworkAdmin();
    }

    // What a space chooses to share: its level, domain averages and health
    // check, never a single standard's score. Shared by pressing a button,
    // withdrawn by deleting it.
    match /assessment_summaries/{spaceId} {
      function d() { return request.resource.data; }
      allow get: if signedIn() && caresFor(spaceId);
      allow list: if isSteward() || isNetworkAdmin();
      allow create, update: if isOrganiserAt(spaceId) && spaceExists(spaceId) && !isPartnerOrg(spaceId)
        && d().keys().hasOnly(['framework_version', 'level', 'avg', 'evidence_share', 'applicable', 'scored', 'urgent',
                               'domains', 'health', 'shared_by', 'shared_at'])
        && d().framework_version is int
        && d().level in ['emerging', 'foundational', 'operational', 'accredited']
        && d().avg is number && d().evidence_share is number
        && d().applicable is int && d().scored is int && d().urgent is int
        && d().domains is list && d().domains.size() <= 20
        && d().health is list && d().health.size() <= 30
        && d().shared_by == uid()
        && isIso(d().shared_at);
      allow delete: if isOrganiserAt(spaceId) || isNetworkAdmin();
    }

    // ---------- feedback ----------
    // Early users tell us what is wrong. Anyone may send, signed in or not,
    // because the people who give up before signing in are the ones we most
    // need to hear from. Write-only for them; stewards read.
    match /feedback/{id} {
      function d() { return request.resource.data; }
      allow create: if d().keys().hasOnly(['message', 'email', 'page', 'uid', 'created_at', 'user_agent'])
        && d().message is string && d().message.size() > 0 && d().message.size() <= 4000
        && (d().email == null || (d().email is string && d().email.size() <= 200))
        && d().page is string && d().page.size() <= 500
        && (d().user_agent == null || (d().user_agent is string && d().user_agent.size() <= 300))
        && (d().uid == null || (signedIn() && d().uid == uid()))
        && isIso(d().created_at);
      allow read: if isSteward() || isNetworkAdmin();
      allow delete: if isNetworkAdmin();
    }

    // ---------- roster ----------
    match /roster/{personId} {
      function d() { return request.resource.data; }
      function m() { return getAfter(membershipPath(personId, d().space_id)).data; }
      function p() { return getAfter(path('people', personId)).data; }
      // Who may show a direct address: organisers, and partners, whom a
      // steward has vetted and who are usually public-facing already.
      function organiser() { return m().role in ['space_admin', 'space_editor', 'partner']; }
      // The projection must agree with its sources, after this batch.
      function faithful() {
        return d().keys().hasOnly(['name', 'space_id', 'space_name', 'state', 'region_id', 'role', 'functions',
                                   'email', 'phone', 'updated_at'])
          && existsAfter(membershipPath(personId, d().space_id))
          && m().status == 'active'
          && p().primary_space_id == d().space_id
          && d().name == p().name
          && d().role == m().role
          && d().functions == m().functions
          && d().state == m().state
          && d().region_id == m().region_id
          && d().space_name == space(d().space_id).name
          && (d().email == null || (organiser() && m().contact_preference == 'email' && d().email == p().email))
          && (d().phone == null || (organiser() && m().contact_preference == 'phone' && d().phone == p().phone))
          && isIso(d().updated_at);
      }
      // National, not regional: any verified person sees every other one.
      allow read: if isVerified() || isSteward() || isNetworkAdmin();
      allow create, update: if faithful() && (
          uid() == personId
          || isSpaceAdmin(d().space_id)
          || isStewardOf(d().region_id)
          || isNetworkAdmin());
      allow delete: if signedIn() && (
          uid() == personId
          || isSpaceAdmin(resource.data.space_id)
          || isStewardOf(resource.data.region_id)
          || isNetworkAdmin());
    }

    // ---------- messages ----------
    match /messages/{id} {
      function d() { return request.resource.data; }
      allow create: if (isVerified() || isSteward() || isNetworkAdmin())
        && d().keys().hasOnly(['from_uid', 'from_name', 'to_uid', 'subject', 'body', 'created_at', 'status', 'read'])
        && d().from_uid == uid()
        && d().from_name == personDoc().name
        && d().to_uid is string && d().to_uid != uid()
        && exists(path('roster', d().to_uid))
        && d().subject is string && d().subject.size() <= 200
        && d().body is string && d().body.size() > 0 && d().body.size() <= 4000
        && d().status == 'queued' && d().read == false
        && isIso(d().created_at);
      allow read: if signedIn() && (resource.data.to_uid == uid() || resource.data.from_uid == uid());
      allow update: if signedIn() && resource.data.to_uid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isNetworkAdmin();
    }

    // ---------- invitations ----------
    // GOVERNANCE §Invitations. A steward, network admin or space admin
    // invites a named person by email, with the role and functions filled in.
    // Nobody sees the invitation but the inviters and the invitee, and it
    // becomes a membership only when the invitee signs in with that exact
    // verified address and accepts. The id is not a secret: holding the link
    // without the mailbox gets you nothing.
    function mayInvite(spaceId, regionId, role) {
      return isNetworkAdmin() || isStewardOf(regionId)
        || (isSpaceAdmin(spaceId) && role in ['space_admin', 'space_editor', 'space_contact']);
    }

    match /invitations/{iid} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['email', 'name', 'space_id', 'space_name', 'role', 'functions', 'note',
                                   'region_id', 'invited_by', 'invited_by_name', 'status', 'created_at',
                                   'expires_at', 'accepted_at', 'email_requested_at', 'emailed_at', 'group_ids', 'updated_at'])
          && d().email is string && d().email == d().email.lower() && d().email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && iid == d().space_id + '~' + d().email
          && spaceExists(d().space_id) && space(d().space_id).proposed == false
          && d().space_name == space(d().space_id).name
          && d().region_id == space(d().space_id).region_id
          && d().name is string && d().name.size() > 0 && d().name.size() <= 120
          && d().role in ['space_admin', 'space_editor', 'space_contact', 'partner']
          && (d().role == 'partner') == isPartnerOrg(d().space_id)
          && d().functions is list && d().functions.size() <= 10
          && d().note is string && d().note.size() <= 2000
          && d().invited_by_name is string && d().invited_by_name.size() <= 120
          && d().status in ['pending', 'accepted', 'revoked']
          && d().expires_at is timestamp
          && (d().email_requested_at == null || isIso(d().email_requested_at))
          && d().group_ids is list && d().group_ids.size() <= 10
          && isIso(d().updated_at);
      }
      function invitee() { return emailVerified() && resource.data.email == tokenEmail(); }

      allow read: if signedIn() && (invitee() || isSteward() || isNetworkAdmin()
                                    || isSpaceAdmin(resource.data.space_id));
      allow create: if shape() && mayInvite(d().space_id, d().region_id, d().role)
        && d().invited_by == uid()
        && d().status == 'pending'
        && d().accepted_at == null && d().emailed_at == null
        && isIso(d().created_at)
        && d().expires_at > request.time && d().expires_at < request.time + duration.value(31, 'd');
      allow update: if shape() && d().email == resource.data.email && d().space_id == resource.data.space_id && (
          // An inviter re-issues or revokes one that has not been accepted.
          // emailed_at belongs to the mailer Function.
          (mayInvite(d().space_id, d().region_id, d().role)
            && resource.data.status != 'accepted' && d().status in ['pending', 'revoked']
            && d().invited_by == uid()
            && d().accepted_at == null && d().emailed_at == resource.data.emailed_at
            && d().expires_at < request.time + duration.value(31, 'd'))
          // The invitee accepts, in the batch that creates the membership.
          || (invitee() && resource.data.status == 'pending' && d().status == 'accepted'
            && request.time < resource.data.expires_at
            && d().diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_at', 'updated_at'])
            && isIso(d().accepted_at)
            && getAfter(membershipPath(uid(), resource.data.space_id)).data.status == 'active'
            && getAfter(membershipPath(uid(), resource.data.space_id)).data.role == resource.data.role));
      allow delete: if signedIn() && mayInvite(resource.data.space_id, resource.data.region_id, resource.data.role);
    }

    // ---------- groups ----------
    // A mailing list with an archive, in place of a Google Group. Members are
    // verified people; posts arrive from the site (checked here) or by email
    // (written by the groupInbound Function, which these rules never see).
    function groupPath(gid) { return path('groups', gid); }
    function group(gid) { return get(groupPath(gid)).data; }
    function groupMemberPath(gid, u) { return /databases/$(database)/documents/groups/$(gid)/members/$(u); }
    function managesGroup(gid) {
      return signedIn() && (uid() in group(gid).manager_uids || convenes(group(gid).region_id));
    }
    function inGroup(gid) { return signedIn() && exists(groupMemberPath(gid, uid())) && isVerified(); }
    function mayPost(gid) {
      return inGroup(gid) && group(gid).archived == false
        && (group(gid).posting == 'members' || managesGroup(gid));
    }

    match /groups/{gid} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['name', 'slug', 'description', 'region_id', 'manager_uids', 'join_policy',
                                   'posting', 'archived', 'created_by', 'created_at', 'updated_at'])
          && gid.matches('^[a-z0-9][a-z0-9-]{2,39}$') && d().slug == gid
          && gid != 'reply' && gid != 'postmaster' && gid != 'abuse'
          && d().name is string && d().name.size() > 0 && d().name.size() <= 120
          && d().description is string && d().description.size() <= 2000
          && d().manager_uids is list && d().manager_uids.size() <= 20
          && d().join_policy in ['open', 'managers']
          && d().posting in ['members', 'managers']
          && d().archived is bool
          && isIso(d().updated_at);
      }
      // The list of groups is visible to every verified person, so they can
      // find and join the open ones.
      allow read: if isVerified() || isSteward() || isNetworkAdmin();
      allow create: if shape() && convenes(d().region_id) && d().created_by == uid() && isIso(d().created_at);
      allow update: if shape() && managesGroup(gid)
        && d().region_id == resource.data.region_id
        && d().created_by == resource.data.created_by && d().created_at == resource.data.created_at;
      allow delete: if convenes(resource.data.region_id);

      match /members/{pid} {
        function m() { return request.resource.data; }
        function memberShape() {
          return m().keys().hasOnly(['name', 'delivery', 'added_by', 'via_invitation', 'joined_at', 'updated_at'])
            && m().name is string && m().name.size() > 0 && m().name.size() <= 120
            && m().delivery in ['each', 'none']
            && isIso(m().updated_at);
        }
        // Joining on the strength of an invitation that named this group.
        function invitedHere() {
          return m().via_invitation is string
            && get(invitationPath(m().via_invitation, tokenEmail())).data.status == 'accepted'
            && gid in get(invitationPath(m().via_invitation, tokenEmail())).data.group_ids;
        }
        allow read: if inGroup(gid) || managesGroup(gid);
        allow create: if memberShape() && m().added_by == uid() && (
            (uid() == pid && isVerified() && group(gid).archived == false
              && (group(gid).join_policy == 'open' || invitedHere()))
            // A manager adds anyone already on the roster.
            || (managesGroup(gid) && exists(path('roster', pid)) && m().via_invitation == null));
        allow update: if memberShape() && (
            (uid() == pid && m().diff(resource.data).affectedKeys().hasOnly(['delivery', 'name', 'updated_at']))
            || managesGroup(gid));
        allow delete: if signedIn() && (uid() == pid || managesGroup(gid));
      }

      match /threads/{tid} {
        function t() { return request.resource.data; }
        allow read: if inGroup(gid) || managesGroup(gid);
        allow create: if mayPost(gid)
          && t().keys().hasOnly(['subject', 'started_by', 'started_by_name', 'created_at', 'last_post_at',
                                 'last_author_name', 'post_count'])
          && t().subject is string && t().subject.size() > 0 && t().subject.size() <= 200
          && t().started_by == uid() && t().started_by_name == personDoc().name
          && t().last_author_name == personDoc().name
          && t().post_count == 1 && isIso(t().created_at) && isIso(t().last_post_at);
        // A reply bumps the counters; a manager may also fix a subject.
        allow update: if (mayPost(gid)
            && t().diff(resource.data).affectedKeys().hasOnly(['last_post_at', 'last_author_name', 'post_count'])
            && t().post_count == resource.data.post_count + 1
            && t().last_author_name == personDoc().name && isIso(t().last_post_at))
          || (managesGroup(gid) && t().diff(resource.data).affectedKeys().hasOnly(['subject']));
        allow delete: if managesGroup(gid);

        match /posts/{pid} {
          function p() { return request.resource.data; }
          allow read: if inGroup(gid) || managesGroup(gid);
          allow create: if mayPost(gid)
            && p().keys().hasOnly(['author_uid', 'author_name', 'body', 'created_at', 'source', 'status', 'sent_count'])
            && p().author_uid == uid() && p().author_name == personDoc().name
            && p().body is string && p().body.size() > 0 && p().body.size() <= 20000
            && p().source == 'web' && p().status == 'queued' && p().sent_count == 0
            && isIso(p().created_at);
          // A manager releases or rejects a held post; nothing else changes.
          allow update: if managesGroup(gid) && resource.data.status == 'held'
            && p().status in ['queued', 'rejected']
            && p().diff(resource.data).affectedKeys().hasOnly(['status']);
          allow delete: if signedIn() && (resource.data.author_uid == uid() || managesGroup(gid));
        }
      }
    }

    // ---------- meetings ----------
    // Convening (GOVERNANCE §Roster). A steward turns a roster query into an
    // invitation list; the list is frozen on the meeting so the record shows
    // who was asked, not who happens to match the filter today.
    function convenes(regionId) { return isNetworkAdmin() || isStewardOf(regionId); }

    match /meetings/{mid} {
      function d() { return request.resource.data; }
      function shape() {
        return d().keys().hasOnly(['title', 'agenda', 'starts_at', 'duration_min', 'location', 'audience',
                                   'region_id', 'organiser_uid', 'organiser_name', 'invitee_uids', 'status',
                                   'email_requested_at', 'emailed_uids', 'created_at', 'updated_at'])
          && d().title is string && d().title.size() > 0 && d().title.size() <= 200
          && d().agenda is string && d().agenda.size() <= 4000
          && isIso(d().starts_at)
          && d().duration_min is int && d().duration_min >= 5 && d().duration_min <= 600
          && d().location is string && d().location.size() <= 300
          && d().audience is string && d().audience.size() <= 300
          && d().organiser_name is string && d().organiser_name.size() <= 120
          && d().invitee_uids is list && d().invitee_uids.size() <= 1000
          && d().status in ['scheduled', 'cancelled']
          && (d().email_requested_at == null || isIso(d().email_requested_at))
          && d().emailed_uids is list
          && isIso(d().updated_at);
      }
      allow read: if signedIn() && (
          isSteward() || isNetworkAdmin()
          || resource.data.organiser_uid == uid()
          || (uid() in resource.data.invitee_uids && isVerified()));
      allow create: if shape() && convenes(d().region_id)
        && d().organiser_uid == uid()
        && d().status == 'scheduled'
        && d().emailed_uids.size() == 0
        && isIso(d().created_at);
      // emailed_uids belongs to the mailer Function; clients never move it.
      allow update: if shape() && convenes(resource.data.region_id)
        && d().organiser_uid == resource.data.organiser_uid
        && d().region_id == resource.data.region_id
        && d().created_at == resource.data.created_at
        && d().emailed_uids == resource.data.emailed_uids;
      allow delete: if convenes(resource.data.region_id);

      // One per invitee. The invitee answers; the convener records attendance.
      match /rsvps/{pid} {
        function r() { return request.resource.data; }
        function meeting() { return get(path('meetings', mid)).data; }
        function rsvpShape() {
          return r().keys().hasOnly(['response', 'attended', 'updated_at'])
            && (r().response == null || r().response in ['yes', 'no', 'maybe'])
            && (r().attended == null || r().attended is bool)
            && isIso(r().updated_at);
        }
        function invitee() { return signedIn() && uid() == pid && uid() in meeting().invitee_uids && isVerified(); }
        function convener() { return convenes(meeting().region_id); }
        allow read: if signedIn() && (isSteward() || isNetworkAdmin()
          || (uid() in meeting().invitee_uids && isVerified()));
        allow create: if rsvpShape() && (
            (invitee() && r().attended == null)
            || (convener() && r().response == null && pid in meeting().invitee_uids));
        allow update: if rsvpShape() && (
            (invitee() && r().diff(resource.data).affectedKeys().hasOnly(['response', 'updated_at']))
            || (convener() && r().diff(resource.data).affectedKeys().hasOnly(['attended', 'updated_at'])));
        allow delete: if convener();
      }
    }

    // ---------- audit ----------
    match /audit/{id} {
      allow create: if signedIn() && request.resource.data.actor == uid()
        && request.resource.data.keys().hasOnly(['actor', 'action', 'details', 'created_at']);
      allow read: if isSteward() || isNetworkAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
